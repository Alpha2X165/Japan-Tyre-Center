class AddScreen(Screen):

    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        layout = BoxLayout(
            orientation="vertical",
            padding=dp(20),
            spacing=dp(12)
        )

        layout.add_widget(heading("ADD / EDIT TYRE"))

        self.size = make_input("Tyre Size e.g. 145/80 R13")
        self.brand = make_input("Brand e.g. Panther")
        self.price = make_input("Price in Rupees")

        layout.add_widget(self.size)
        layout.add_widget(self.brand)
        layout.add_widget(self.price)

        layout.add_widget(make_button(
            "SAVE TYRE", self.save, GREEN, WHITE
        ))

        layout.add_widget(make_button(
            "BACK TO HOME",
            lambda x: setattr(
                App.get_running_app().sm, "current", "home"
            )
        ))

        self.add_widget(layout)
        self.edit_id = None

    def prepare(self, record=None):
        self.size.text = ""
        self.brand.text = ""
        self.price.text = ""
        self.edit_id = None

        if record:
            self.edit_id = record[0]
            self.size.text = record[1]
            self.brand.text = record[2]
            self.price.text = str(record[3])

    def save(self, instance):
        app = App.get_running_app()

        size = self.size.text.strip().upper()
        brand = self.brand.text.strip()
        price = self.price.text.strip()

        if not size or not brand or not price:
            app.message("Missing Data", "Fill all fields.")
            return

        try:
            price = float(price)
            if price <= 0:
                raise ValueError
        except ValueError:
            app.message("Invalid Price", "Enter a valid price.")
            return

        if self.edit_id:
            app.query("""
                UPDATE tyres SET size=?, brand=?, price=?
                WHERE id=?
            """, (size, brand, price, self.edit_id))
        else:
            app.query("""
                INSERT INTO tyres (size, brand, price)
                VALUES (?, ?, ?)
            """, (size, brand, price))

        self.prepare()
        app.message("Success", "Tyre saved successfully!")


class SearchScreen(Screen):

    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        layout = BoxLayout(
            orientation="vertical",
            padding=dp(18),
            spacing=dp(12)
        )

        layout.add_widget(heading("SEARCH TYRE SIZE"))

        self.search = make_input("Enter tyre size")
        layout.add_widget(self.search)

        layout.add_widget(make_button(
            "SEARCH NOW", self.search_tyre, BLUE, WHITE
        ))

        self.results = BoxLayout(
            orientation="vertical",
            spacing=dp(8)
        )

        scroll = ScrollView()
        scroll.add_widget(self.results)
        layout.add_widget(scroll)

        layout.add_widget(make_button(
            "BACK HOME",
            lambda x: setattr(
                App.get_running_app().sm, "current", "home"
            )
        ))

        self.add_widget(layout)

    def search_tyre(self, instance):
        app = App.get_running_app()
        self.results.clear_widgets()

        term = self.search.text.strip().upper()

        if not term:
            app.message("Search", "Enter a tyre size.")
            return

        rows = app.query("""
            SELECT size, brand, price FROM tyres
            WHERE UPPER(size) LIKE ?
            ORDER BY size, brand
        """, ('%' + term + '%',))

        for size, brand, price in rows:
            self.results.add_widget(Label(
                text=f"{size}   |   {brand}   |   Rs. {price:,.0f}",
                color=NAVY,
                font_size=sp(16),
                size_hint_y=None,
                height=dp(45)
            ))

        if not rows:
            app.message("Not Found", "No matching tyre found.")


class AllScreen(Screen):

    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        layout = BoxLayout(
            orientation="vertical",
            padding=dp(15),
            spacing=dp(8)
        )

        layout.add_widget(heading("ALL TYRE PRICES"))

        self.rows_box = BoxLayout(
            orientation="vertical",
            spacing=dp(8),
            size_hint_y=None
        )
        self.rows_box.bind(
            minimum_height=self.rows_box.setter("height")
        )

        scroll = ScrollView()
        scroll.add_widget(self.rows_box)
        layout.add_widget(scroll)

        layout.add_widget(make_button(
            "BACK HOME",
            lambda x: setattr(
                App.get_running_app().sm, "current", "home"
            )
        ))

        self.add_widget(layout)

    def on_pre_enter(self, *args):
        self.refresh()

    def refresh(self):
        app = App.get_running_app()
        self.rows_box.clear_widgets()

        rows = app.query(
            "SELECT id, size, brand, price FROM tyres ORDER BY size, brand"
        )

        if not rows:
            self.rows_box.add_widget(Label(
                text="No tyre records saved yet.",
                color=NAVY,
                size_hint_y=None,
                height=dp(60)
            ))

        for record in rows:
            rid, size, brand, price = record

            row = BoxLayout(
                size_hint_y=None,
                height=dp(95),
                spacing=dp(5)
            )

            info = Label(
                text=f"{size}\n{brand} | Rs. {price:,.0f}",
                color=NAVY,
                font_size=sp(14)
            )
            row.add_widget(info)

            row.add_widget(make_button(
                "EDIT",
                lambda x, r=record: self.edit_record(r),
                BLUE, WHITE
            ))

            row.add_widget(make_button(
                "DELETE",
                lambda x, i=rid: self.delete_record(i),
                RED, WHITE
            ))

            self.rows_box.add_widget(row)

    def edit_record(self, record):
        app = App.get_running_app()
        screen = app.sm.get_screen("add")
        screen.prepare(record)
        app.sm.current = "add"

    def delete_record(self, rid):
        app = App.get_running_app()

        content = BoxLayout(
            orientation="vertical",
            spacing=dp(12),
            padding=dp(12)
        )

        content.add_widget(Label(
            text="Delete this tyre record?",
            color=NAVY
        ))

        buttons = BoxLayout(spacing=dp(10))

        popup = Popup(
            title="Confirm Delete",
            content=content,
            size_hint=(0.85, 0.3)
        )

        buttons.add_widget(make_button(
            "YES",
            lambda x: self.confirm_delete(rid, popup),
            RED, WHITE
        ))

        buttons.add_widget(make_button(
            "NO", lambda x: popup.dismiss()
        ))

        content.add_widget(buttons)
        popup.open()

    def confirm_delete(self, rid, popup):
        app = App.get_running_app()
        app.query("DELETE FROM tyres WHERE id=?", (rid,))
        popup.dismiss()
        self.refresh()


class SettingsScreen(Screen):

    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        layout = BoxLayout(
            orientation="vertical",
            padding=dp(20),
            spacing=dp(12)
        )

        layout.add_widget(heading("SETTINGS"))

        self.old = make_input("Old Password", True)
        self.new = make_input("New Password", True)
        self.confirm = make_input("Confirm New Password", True)

        layout.add_widget(self.old)
        layout.add_widget(self.new)
        layout.add_widget(self.confirm)

        layout.add_widget(make_button(
            "CHANGE PASSWORD",
            self.change,
            BLUE, WHITE
        ))

        layout.add_widget(make_button(
            "BACK HOME",
            lambda x: setattr(
                App.get_running_app().sm, "current", "home"
            )
        ))

        self.add_widget(layout)

    def change(self, instance):
        app = App.get_running_app()

        if not self.new.text:
            app.message("Error", "New password is empty.")
            return

        if len(self.new.text) < 6:
            app.message("Error", "Use at least 6 characters.")
            return

        if self.new.text != self.confirm.text:
            app.message("Error", "Passwords do not match.")
            return

        if app.change_password(
            self.old.text, self.new.text
        ):
            self.old.text = ""
            self.new.text = ""
            self.confirm.text = ""
            app.message("Success", "Password changed!")
        else:
            app.message("Error", "Old password is incorrect.")


