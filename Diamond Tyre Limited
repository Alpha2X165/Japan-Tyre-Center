def make_password(password, salt):
    return hashlib.pbkdf2_hmac(
        "sha256", password.encode(),
        salt, 200000
    )


class TyreApp(App):

    def build(self):
        self.title = "Japan Tyre Center"
        self.db_path = os.path.join(
            self.user_data_dir, "tyres.db"
        )
        self.setup_database()

        self.sm = ScreenManager()

        for name, screen in [
            ("login", LoginScreen()),
            ("home", HomeScreen()),
            ("add", AddScreen()),
            ("search", SearchScreen()),
            ("all", AllScreen()),
            ("settings", SettingsScreen())
        ]:
            screen.name = name
            self.sm.add_widget(screen)

        return self.sm

    def setup_database(self):
        db = sqlite3.connect(self.db_path)
        c = db.cursor()

        c.execute("""
        CREATE TABLE IF NOT EXISTS tyres (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            size TEXT NOT NULL,
            brand TEXT NOT NULL,
            price REAL NOT NULL
        )
        """)

        c.execute("""
        CREATE TABLE IF NOT EXISTS settings (
            key TEXT PRIMARY KEY,
            value TEXT NOT NULL
        )
        """)

        if not c.execute(
            "SELECT value FROM settings WHERE key='salt'"
        ).fetchone():

            salt = secrets.token_bytes(16)
            hashed = make_password("Alpha X2", salt)

            c.execute(
                "INSERT INTO settings VALUES (?,?)",
                ("salt", salt.hex())
            )
            c.execute(
                "INSERT INTO settings VALUES (?,?)",
                ("password", hashed.hex())
            )

        db.commit()
        db.close()

    def query(self, sql, values=()):
        db = sqlite3.connect(self.db_path)
        c = db.cursor()
        c.execute(sql, values)
        result = c.fetchall()
        db.commit()
        db.close()
        return result

    def message(self, title, text):
        Popup(
            title=title,
            content=Label(
                text=text,
                color=NAVY,
                font_size=sp(16)
            ),
            size_hint=(0.85, 0.30)
        ).open()

    def check_password(self, password):
        salt = bytes.fromhex(
            self.query(
                "SELECT value FROM settings WHERE key='salt'"
            )[0][0]
        )
        saved = self.query(
            "SELECT value FROM settings WHERE key='password'"
        )[0][0]

        actual = make_password(password, salt).hex()
        return hmac.compare_digest(actual, saved)

    def change_password(self, old, new):
        if not self.check_password(old):
            return False

        salt = secrets.token_bytes(16)
        hashed = make_password(new, salt).hex()

        self.query(
            "UPDATE settings SET value=? WHERE key='salt'",
            (salt.hex(),)
        )
        self.query(
            "UPDATE settings SET value=? WHERE key='password'",
            (hashed,)
        )
        return True


def heading(text, size=22, color=NAVY):
    return Label(
        text=text,
        font_size=sp(size),
        bold=True,
        color=color,
        size_hint_y=None,
        height=dp(55)
    )


def make_button(text, callback, color=WHITE, text_color=NAVY):
    btn = Button(
        text=text,
        font_size=sp(17),
        bold=True,
        color=text_color,
        background_normal="",
        background_down="",
        background_color=color,
        size_hint_y=None,
        height=dp(58)
    )
    btn.bind(on_release=callback)
    return btn


def make_input(hint, password=False):
    return TextInput(
        hint_text=hint,
        password=password,
        multiline=False,
        font_size=sp(17),
        size_hint_y=None,
        height=dp(52),
        padding=[dp(12), dp(13)],
        background_color=WHITE,
        foreground_color=NAVY,
        hint_text_color=(0.4, 0.45, 0.5, 1)
    )


class LoginScreen(Screen):

