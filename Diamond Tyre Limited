        super().__init__(**kwargs)

        layout = BoxLayout(
            orientation="vertical",
            padding=dp(25),
            spacing=dp(18)
        )

        layout.add_widget(Label(
            text="JAPAN TYRE CENTER",
            font_size=sp(27),
            bold=True,
            color=NAVY
        ))

        layout.add_widget(Label(
            text="TYRE MANAGEMENT SYSTEM\nAwais Creator",
            font_size=sp(18),
            bold=True,
            color=BLUE
        ))

        layout.add_widget(heading("SECURE LOGIN"))

        self.password = make_input(
            "Enter Password", True
        )
        layout.add_widget(self.password)

        layout.add_widget(make_button(
            "LOGIN",
            self.login,
            BLUE,
            WHITE
        ))

        layout.add_widget(Label(
            text="OFFLINE APPLICATION",
            color=GREEN,
            font_size=sp(13)
        ))

        self.add_widget(layout)

    def login(self, instance):
        app = App.get_running_app()

        if app.check_password(self.password.text):
            self.password.text = ""
            app.sm.current = "home"
        else:
            app.message(
                "Login Failed", "Incorrect password!"
            )


